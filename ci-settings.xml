<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI settings for GitLab Package Registry.
  CI_JOB_TOKEN is automatically injected by GitLab CI — no manual variable configuration required.
  For manual deploy from a developer machine, replace CI_JOB_TOKEN with a Deploy Token
  or a Personal Access Token (scoped read_package_registry + write_package_registry)
  stored in ~/.m2/settings.xml (never in this file).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>gitlab-maven</id>
      <username>gitlab-ci-token</username>
      <password>${env.CI_JOB_TOKEN}</password>
    </server>
  </servers>
</settings>
